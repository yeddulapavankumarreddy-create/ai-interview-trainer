# ============================================================
# AI Interview Trainer — Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ─── IBM watsonx.ai / IBM Granite Configuration ──────────────
# Obtain these from your IBM Cloud / watsonx.ai project.
# Leave blank to run in Demo Mode.

# Your IBM watsonx.ai service URL (bare base URL, region-specific)
# Example: https://us-south.ml.cloud.ibm.com
WATSONX_URL="https://us-south.ml.cloud.ibm.com"

# Your IBM Cloud IAM API Key
WATSONX_API_KEY="your_ibm_cloud_api_key_here"

# Your watsonx.ai Project ID
WATSONX_PROJECT_ID="your_watsonx_project_id_here"

# Granite model to use
# Default used by the application: ibm/granite-13b-chat-v2
GRANITE_MODEL_ID="ibm/granite-13b-chat-v2"

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to use sample data when Granite is not configured.
# Set to "false" when Granite credentials are configured above.
DEMO_MODE=true

# ─── Database ────────────────────────────────────────────────
# SQLite default — no configuration needed for local dev.
# For PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./interview_trainer.db

# ─── File Upload ─────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ─── Frontend ────────────────────────────────────────────────
# Origins allowed by CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Knowledge Base ──────────────────────────────────────────
# Path to the knowledge_base directory (relative to project root)
# KNOWLEDGE_BASE_DIR=../knowledge_base
